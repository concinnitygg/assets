// The custom shaders on display at golden hour: cel-shaded sculptures, a hologram, a lava pool and banners in the wind.
["AppConfig",{"name":"Shader Gallery"}]
["GraphicsConfig",{"shadows":{"map_size":2048},"anti_aliasing":{"mode":"taa"},"exposure":{"auto":true},"bloom":{"intensity":0.3,"threshold":1.2}}]
["Include",{"path":"shaders/shaders.jsonl"}]
["Include",{"path":"materials/surfaces.jsonl"}]
["Include",{"path":"props/architecture.jsonl"}]
["Include",{"path":"environments/golden_hour.jsonl"}]
